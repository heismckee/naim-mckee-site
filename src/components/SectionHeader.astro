---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
  id?: string;
}
const { index, title, subtitle, id } = Astro.props;
---
<header class="sh">
  <p class="sh__index" aria-hidden="true">{index}</p>
  <div class="sh__titles">
    <h2 class="h1" id={id}>{title}</h2>
    {subtitle && <p class="body-l secondary">{subtitle}</p>}
  </div>
</header>

<style>
  .sh {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    padding-top: 24px;
    border-top: 2px solid var(--color-border-strong);
  }
  .sh__index {
    flex: none;
    width: 120px;
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text-accent);
  }
  .sh__titles { display: flex; flex-direction: column; gap: 10px; min-width: 0; }

  @media (max-width: 760px) {
    .sh { flex-direction: column; gap: 4px; padding-top: 20px; }
    .sh__index {
      width: auto;
      font-family: var(--font-mono);
      font-weight: 500;
      font-size: 13px;
      line-height: 1.4;
      letter-spacing: 0.08em;
    }
  }
</style>
