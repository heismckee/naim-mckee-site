---
import Button from './Button.astro';
import BuildThumb from './BuildThumb.astro';
import type { Build } from '../data/site';
interface Props { build: Build; class?: string }
const { build, class: cls = '' } = Astro.props;
---
<article class:list={['bc', cls]}>
  <BuildThumb kind={build.key} />
  <p class="label-mono accent">{build.type}</p>
  <h3 class="h3">{build.title}</h3>
  <p class="body secondary">{build.description}</p>
  {build.href && <div class="bc__cta"><Button href={build.href} variant="link">{build.cta}</Button></div>}
</article>

<style>
  .bc {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-strong);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }
  .bc :global(.thumb) { margin-bottom: 0; }
  .bc__cta { margin-top: auto; padding-top: 0; }
</style>
